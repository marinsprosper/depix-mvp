# sandbox não chama a Eulen; live exige as credenciais abaixo.
PROVIDER_MODE=sandbox
PLATFORM_NAME=DePix Pay

# Eulen / DePix — Client Credentials. Armazene somente no servidor.
EULEN_BASE_URL=https://api.eulen.app
EULEN_CLIENT_ID=
EULEN_CLIENT_SECRET=
EULEN_WEBHOOK_SECRET=

# Painel administrativo interno.
ADMIN_TOKEN=troque-por-um-segredo-longo-e-aleatorio
PORT=3000
